#!/usr/bin/env bash
#MISE description="End-to-end: two projects pinning different versions of the same helm plugin"
#
# DESIGN.md §3 testing notes: two sibling directories, each pinning a different
# version of helm-diff; confirm helm sees the right one in each, and that the
# project with two plugins sees both.
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command -v helm >/dev/null || {
    echo "helm not found on PATH — it's a hard dependency of this backend" >&2
    exit 1
}

mise plugin link --force helm-plugin "$plugin_dir"

root="$(mktemp -d)"
# Each project's HELM_PLUGINS lives under XDG state, keyed on a hash of its
# config_root — outside $root, so it needs cleaning up separately or every run
# leaves another orphan behind. Collected as the projects are visited.
targets=()
cleanup() {
    rm -rf "$root" ${targets[@]+"${targets[@]}"}
}
trap cleanup EXIT

make_project() {
    local dir="$1" helm_major="$2" diff_version="$3" secrets_version="$4" diff_style="${5:-shorthand}"
    mkdir -p "$dir"
    {
        echo '[tools]'
        # Pin helm explicitly so the test covers both majors rather than
        # whatever happens to be on PATH. helm 4 needs --verify=false at install
        # time, which BackendInstall detects; helm-secrets < 4.6.5 won't load on
        # helm 4 at all, so the versions differ per project by necessity.
        echo "helm = \"$helm_major\""
        if [ "$diff_style" = inline ]; then
            # "diff-inline" is deliberately absent from PLUGIN.tools, so the repo
            # can only come from the inline option that mise forwards to the
            # hooks as ctx.options. helm still reports the plugin as "diff": the
            # name comes from plugin.yaml, not from the mise tool name. Aimed at
            # helm-diff rather than some third plugin on purpose — this is a test
            # of resolution, and a second real dependency would only add ways for
            # it to fail for unrelated reasons.
            echo "\"helm-plugin:diff-inline\" = { version = \"$diff_version\", repo = \"databus23/helm-diff\" }"
        else
            echo "\"helm-plugin:helm-diff\" = \"$diff_version\""
        fi
        [ "$secrets_version" != none ] && echo "\"helm-plugin:helm-secrets\" = \"$secrets_version\""
        echo
        echo '[env]'
        echo 'HELM_PLUGINS = "{{xdg_state_home}}/helm-plugins/{{ config_root | basename }}-{{ config_root | hash(len=8) }}"'
        echo
        echo '[hooks]'
        # Bare name, not a path: BackendExecEnv puts the plugin's bin/ on PATH.
        echo 'enter = "helm-plugins-sync"'
    } >"$dir/mise.toml"

    # Explicit, not incidental: an untrusted config with [env]/[hooks] fails to
    # parse at all, so without this the test depends on the machine happening to
    # have trusted this path before. A clean CI runner never has.
    mise trust "$dir/mise.toml" >/dev/null
}

# a: helm 3, one plugin.  b: helm 4, two plugins, incl. a helm-4-capable secrets.
# c: helm 3, one plugin named only by an inline repo rather than a built-in
#    shorthand. a and b keep covering PLUGIN.tools.
make_project "$root/a" 3 3.9.0 none
make_project "$root/b" 4 3.10.0 4.7.7
make_project "$root/c" 3 3.9.0 none inline

fail=0

check() {
    local dir="$1" expected_diff="$2" expected_count="$3"

    cd "$dir"
    mise install >/dev/null
    # The `enter` hook fires on cd in an activated shell; invoke it directly
    # here, resolved off PATH exactly as the hook would.
    mise exec -- helm-plugins-sync

    local project_target
    project_target="$(mise env -s bash | sed -n 's/^export HELM_PLUGINS=//p')"
    targets+=("$project_target")

    echo "=== $dir (helm $(mise exec -- helm version --short)) ==="
    echo "HELM_PLUGINS=$project_target"
    mise exec -- helm plugin list

    local actual_diff actual_count
    actual_diff="$(mise exec -- helm plugin list | awk '$1 == "diff" { print $2 }')"
    actual_count="$(mise exec -- helm plugin list | tail -n +2 | grep -c . || true)"

    if [ "$actual_diff" != "$expected_diff" ]; then
        echo "FAIL: expected diff $expected_diff, got '${actual_diff:-none}'" >&2
        fail=1
    fi
    if [ "$actual_count" != "$expected_count" ]; then
        echo "FAIL: expected $expected_count plugin(s), got $actual_count" >&2
        fail=1
    fi
    echo
}

# Visit a, then b, then a again — the revisit is what catches stale state
# leaking between projects.
check "$root/a" 3.9.0 1
check "$root/b" 3.10.0 2
check "$root/a" 3.9.0 1
# Same expectations as a, reached entirely through the inline repo option.
check "$root/c" 3.9.0 1

# Resolution failures should say what to do about them, since an unknown plugin
# name is now a normal thing to hit rather than a hard wall.
# $1=label  $2=tool name  $3=[tools] entry  $4=expected substring
check_error() {
    local label="$1" tool="$2" entry="$3" expected="$4" out
    mkdir -p "$root/err"
    printf '[tools]\n%s\n' "$entry" >"$root/err/mise.toml"
    # Re-trust on every rewrite: trust is recorded per file content, and an
    # untrusted config is skipped rather than parsed — which would make these
    # assertions pass without the inline options ever reaching the hook.
    mise trust "$root/err/mise.toml" >/dev/null
    cd "$root/err"

    out="$(mise ls-remote "helm-plugin:$tool" 2>&1 || true)"
    if [[ "$out" == *"$expected"* ]]; then
        echo "  [$label] reported: ...$expected..."
    else
        echo "FAIL [$label]: expected an error containing '$expected', got:" >&2
        echo "$out" >&2
        fail=1
    fi
}

echo "=== resolution errors ==="
check_error "unknown-tool" "totally-unknown" \
    '"helm-plugin:totally-unknown" = "1.0.0"' \
    'name the repo inline'
check_error "bad-repo" "bad" \
    '"helm-plugin:bad" = { version = "1.0.0", repo = "https://github.com/foo/bar" }' \
    'expected an "owner/repo" GitHub slug'
echo

if [ "$fail" -eq 0 ]; then
    echo "PASS: every project saw its own pinned versions, by shorthand and by inline repo"
else
    echo "FAILED" >&2
    exit 1
fi
