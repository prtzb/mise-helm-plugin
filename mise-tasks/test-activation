#!/usr/bin/env bash
#MISE description="End-to-end: two projects pinning different versions of the same helm plugin"
#
# PLAN.md testing plan: two sibling directories, each pinning a different
# version of helm-diff; confirm helm sees the right one in each, and that the
# project with two plugins sees both.
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command -v helm >/dev/null || {
    echo "helm not found on PATH — it's a hard dependency of this backend" >&2
    exit 1
}

mise plugin link --force helm-plugin "$plugin_dir"

root="$(mktemp -d)"
trap 'rm -rf "$root"' EXIT

make_project() {
    local dir="$1" helm_major="$2" diff_version="$3" secrets_version="$4"
    mkdir -p "$dir"
    {
        echo '[tools]'
        # Pin helm explicitly so the test covers both majors rather than
        # whatever happens to be on PATH. helm 4 needs --verify=false at install
        # time, which BackendInstall detects; helm-secrets < 4.6.5 won't load on
        # helm 4 at all, so the versions differ per project by necessity.
        echo "helm = \"$helm_major\""
        echo "\"helm-plugin:helm-diff\" = \"$diff_version\""
        [ "$secrets_version" != none ] && echo "\"helm-plugin:helm-secrets\" = \"$secrets_version\""
        echo
        echo '[env]'
        echo 'HELM_PLUGINS = "{{xdg_state_home}}/helm-plugins/{{ config_root | basename }}-{{ config_root | hash(len=8) }}"'
        echo
        echo '[hooks]'
        # Bare name, not a path: BackendExecEnv puts the plugin's bin/ on PATH.
        echo 'enter = "helm-plugins-sync"'
    } >"$dir/mise.toml"
}

# a: helm 3, one plugin.  b: helm 4, two plugins, incl. a helm-4-capable secrets.
make_project "$root/a" 3 3.9.0 none
make_project "$root/b" 4 3.10.0 4.7.7

fail=0

check() {
    local dir="$1" expected_diff="$2" expected_count="$3"

    cd "$dir"
    mise install >/dev/null
    # The `enter` hook fires on cd in an activated shell; invoke it directly
    # here, resolved off PATH exactly as the hook would.
    mise exec -- helm-plugins-sync

    echo "=== $dir (helm $(mise exec -- helm version --short)) ==="
    mise env -s bash | grep HELM_PLUGINS || true
    mise exec -- helm plugin list

    local actual_diff actual_count
    actual_diff="$(mise exec -- helm plugin list | awk '$1 == "diff" { print $2 }')"
    actual_count="$(mise exec -- helm plugin list | tail -n +2 | grep -c . || true)"

    if [ "$actual_diff" != "$expected_diff" ]; then
        echo "FAIL: expected diff $expected_diff, got '${actual_diff:-none}'" >&2
        fail=1
    fi
    if [ "$actual_count" != "$expected_count" ]; then
        echo "FAIL: expected $expected_count plugin(s), got $actual_count" >&2
        fail=1
    fi
    echo
}

# Visit a, then b, then a again — the revisit is what catches stale state
# leaking between projects.
check "$root/a" 3.9.0 1
check "$root/b" 3.10.0 2
check "$root/a" 3.9.0 1

if [ "$fail" -eq 0 ]; then
    echo "PASS: both projects saw their own pinned versions, including on revisit"
else
    echo "FAILED" >&2
    exit 1
fi
