#!/usr/bin/env bash
#MISE description="Edge cases for helm-plugins-sync: uninstall cleanup, corrupt installs, stray files"
#
# See DESIGN.md, "Other measured facts": there is no BackendUninstall hook in
# mise, so cleanup of stale links is helm-plugins-sync's job on the next run.
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
diff_version="${DIFF_VERSION:-3.9.0}"
secrets_version="${SECRETS_VERSION:-4.6.0}"

command -v helm >/dev/null || {
    echo "helm not found on PATH — it's a hard dependency of this backend" >&2
    exit 1
}

root="$(mktemp -d)"

# The corruption case mutates an install in place, so point MISE_DATA_DIR at a
# scratch directory: even a kill -9 mid-run can only damage this test's copy.
# Costs a fresh extract per run; downloads still come from MISE_CACHE_DIR.
export MISE_DATA_DIR="$root/mise-data"

cleanup() {
    rm -rf "$root" ${target:+"$target"}
}
trap cleanup EXIT

mise plugin link --force helm-plugin "$plugin_dir"

cd "$root"
cat >mise.toml <<EOF
[tools]
helm = "3"
"helm-plugin:helm-diff" = "$diff_version"
"helm-plugin:helm-secrets" = "$secrets_version"

[env]
HELM_PLUGINS = "{{xdg_state_home}}/helm-plugins/{{ config_root | basename }}-{{ config_root | hash(len=8) }}"
EOF

# An untrusted config with [env] doesn't parse at all.
mise trust >/dev/null

mise install >/dev/null
target="$(mise env -s bash | sed -n 's/^export HELM_PLUGINS=//p')"
secrets_plugins="$(mise where "helm-plugin:helm-secrets@$secrets_version")/plugins"

fail=0

# $1=label  $2=expected exit  $3=expected links (space separated, sorted)
check() {
    local label="$1" expected_exit="$2" expected_links="$3"
    local actual_exit=0 actual_links

    mise exec -- helm-plugins-sync || actual_exit=$?
    # LC_ALL=C so dotfiles sort the same on macOS and Linux: a UTF-8 locale
    # collates the leading dot away.
    actual_links="$(find "$target" -mindepth 1 -maxdepth 1 2>/dev/null | sed 's|.*/||' | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//')"

    if [ "$actual_exit" != "$expected_exit" ]; then
        echo "FAIL [$label]: expected exit $expected_exit, got $actual_exit" >&2
        fail=1
    fi
    if [ "$actual_links" != "$expected_links" ]; then
        echo "FAIL [$label]: expected links '$expected_links', got '$actual_links'" >&2
        fail=1
    fi
    echo "  [$label] exit=$actual_exit links='$actual_links'"
}

echo "==> healthy project links both plugins"
check "healthy" 0 "helm-diff helm-secrets"

echo "==> a corrupt install is skipped, not fatal to the others"
mv "$secrets_plugins" "$secrets_plugins.bak"
check "corrupt" 1 "helm-diff"

echo "==> and recovers once repaired"
mv "$secrets_plugins.bak" "$secrets_plugins"
check "repaired" 0 "helm-diff helm-secrets"

echo "==> a stray non-symlink is preserved, not deleted"
touch "$target/keep-me"
check "stray-file" 1 "helm-diff helm-secrets keep-me"
rm -f "$target/keep-me"

echo "==> a stray dotfile is reported, and a stray dot-symlink is pruned"
# Without dotglob both of these pass through the prune loop unseen.
touch "$target/.keep-me"
ln -s /nonexistent "$target/.stale-link"
check "stray-dotfile" 1 ".keep-me helm-diff helm-secrets"
rm -f "$target/.keep-me"

echo "==> a stray directory is refused, not linked into"
# `ln -sfn` would link *into* a real directory rather than replace it.
rm -f "$target/helm-diff"
mkdir "$target/helm-diff"
check "stray-dir" 1 "helm-diff helm-secrets"
if [ -L "$target/helm-diff" ] || [ -n "$(ls -A "$target/helm-diff")" ]; then
    echo "FAIL [stray-dir]: $target/helm-diff was replaced or written into" >&2
    fail=1
fi
rm -rf "$target/helm-diff"

echo "==> dropping a plugin from mise.toml prunes its link"
# Not `sed -i ''` — the empty-suffix form is BSD-only and fails on Linux/CI.
grep -v helm-secrets mise.toml >mise.toml.next && mv mise.toml.next mise.toml
mise trust >/dev/null # trust is per content, so a rewrite invalidates it
check "pruned" 0 "helm-diff"

if [ "$fail" -eq 0 ]; then
    echo "PASS: sync handles uninstall, corruption, and stray files"
else
    echo "FAILED" >&2
    exit 1
fi
