#!/usr/bin/env bash
#MISE description="Install works when helm resolves to a mise shim, as it does under mise-action"
#
# A shim is mise re-execing the real binary, re-applying the project's [env] on
# the way. HELM_PLUGINS is exactly what a project sets there, so an install run
# through a shim lands in the project's plugin directory and reports success.
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
diff_version="${DIFF_VERSION:-3.9.0}"

root="$(mktemp -d)"
export MISE_DATA_DIR="$root/mise-data"

cleanup() {
    rm -rf "$root" ${target:+"$target"}
}
trap cleanup EXIT

mise plugin link --force helm-plugin "$plugin_dir"

# A mise shim is a symlink named after the tool, pointing at the mise binary.
# Built here rather than borrowed from ~/.local/share/mise/shims so the test
# doesn't depend on which tools this machine happens to have installed.
mise_bin="$(command -v mise)"
mkdir -p "$root/shims"
ln -s "$mise_bin" "$root/shims/helm"
export PATH="$root/shims:$PATH"

cd "$root"
cat >mise.toml <<EOF
[tools]
helm = "3"
"helm-plugin:helm-diff" = "$diff_version"

[env]
HELM_PLUGINS = "{{xdg_state_home}}/helm-plugins/{{ config_root | basename }}-{{ config_root | hash(len=8) }}"
EOF
mise trust >/dev/null

resolved="$(command -v helm)"
if [ "$resolved" != "$root/shims/helm" ]; then
    echo "FAIL: helm did not resolve to the shim, got '$resolved' — test proves nothing" >&2
    exit 1
fi
echo "  helm resolves to $resolved -> $(readlink "$resolved")"

mise install >/dev/null
target="$(mise env -s bash | sed -n 's/^export HELM_PLUGINS=//p')"

fail=0

# The plugin must be under the tool's own install path. Without the fix helm
# installs into $target instead and this find comes back empty.
install_path="$(mise where "helm-plugin:helm-diff@$diff_version")"
manifest="$(find "$install_path/plugins" -mindepth 2 -maxdepth 2 -name plugin.yaml -print -quit 2>/dev/null || true)"
if [ -n "$manifest" ]; then
    echo "  installed to $manifest"
else
    echo "FAIL: no plugin.yaml under $install_path/plugins — helm installed somewhere else" >&2
    fail=1
fi

# And nothing should have been written into the project's directory: only
# helm-plugins-sync puts anything there, and only ever symlinks.
# Not yet created at this point unless something wrote to it, which is the
# symptom being checked. || true because under pipefail a missing directory
# would otherwise abort the test.
strays="$(find "$target" -mindepth 1 -maxdepth 1 ! -type l 2>/dev/null | tr '\n' ' ' || true)"
if [ -n "$strays" ]; then
    echo "FAIL: install wrote into the project's HELM_PLUGINS: $strays" >&2
    fail=1
fi

if [ "$fail" -eq 0 ]; then
    echo "PASS: install through a shim lands in the tool's install path"
else
    echo "FAILED" >&2
    exit 1
fi
