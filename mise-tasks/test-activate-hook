#!/usr/bin/env bash
#MISE description="Verify the [hooks] enter entry fires on cd under `mise activate`"
#
# The other tests invoke helm-plugins-sync directly, which proves the script
# works but not that anything ever runs it. This drives real `mise activate`
# shells and only cds — everything else has to follow from mise's activation.
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
diff_version="${DIFF_VERSION:-3.9.0}"
secrets_version="${SECRETS_VERSION:-4.6.0}"

mise plugin link --force helm-plugin "$plugin_dir"

proj="$(mktemp -d)"
trap 'rm -rf "$proj" "${target:-}"' EXIT

cat >"$proj/mise.toml" <<EOF
[tools]
helm = "3"
"helm-plugin:helm-diff" = "$diff_version"
"helm-plugin:helm-secrets" = "$secrets_version"

[env]
HELM_PLUGINS = "{{xdg_state_home}}/helm-plugins/{{ config_root | basename }}-{{ config_root | hash(len=8) }}"

[hooks]
enter = "helm-plugins-sync"
EOF

cd "$proj"
# An untrusted config with [env]/[hooks] doesn't parse at all.
mise trust >/dev/null
mise install >/dev/null
target="$(mise env -s bash | sed -n 's/^export HELM_PLUGINS=//p')"

# Non-interactive on purpose. Both shells hook `cd` without a prompt (zsh via
# add-zsh-hook chpwd, bash via mise's `cd` wrapper), so `-i` adds no fidelity —
# and it would turn on job control, which acts on the controlling terminal no
# matter how stdin is redirected, stealing the foreground process group from
# whatever launched the suite.
#
# Both shells, so the test can never skip entirely: bash is always present.
run_session() {
    local sh="$1"
    local script="$proj/session.$sh"
    {
        # Single-quoted: these expand in the session, not here.
        # shellcheck disable=SC2016
        echo 'export PATH="$HOME/.local/bin:$PATH"'
        echo 'export MISE_YES=1'
        echo "eval \"\$(mise activate $sh)\""
        # Only a cd. No helm-plugins-sync call anywhere.
        echo "cd $proj"
    } >"$script"

    # No startup files: the user's dotfiles must not decide the outcome.
    case "$sh" in
    zsh) zsh -f "$script" ;;
    bash) bash --noprofile --norc "$script" ;;
    esac
}

fail=0

for sh in bash zsh; do
    if ! command -v "$sh" >/dev/null; then
        echo "SKIP [$sh]: not installed"
        continue
    fi

    # Start from nothing, so anything present afterwards was made by the hook.
    rm -rf "$target"
    run_session "$sh" >/dev/null 2>&1 || true

    links="$(find "$target" -mindepth 1 -maxdepth 1 2>/dev/null | sed 's|.*/||' | sort | tr '\n' ' ' | sed 's/ $//')"
    if [ "$links" = "helm-diff helm-secrets" ]; then
        echo "PASS [$sh]: cd alone fired the enter hook and built '$links'"
    else
        echo "FAIL [$sh]: expected 'helm-diff helm-secrets' after cd, got '${links:-nothing}'" >&2
        echo "  the [hooks] enter entry did not run — check that mise activate is in effect" >&2
        fail=1
    fi
done

exit "$fail"
